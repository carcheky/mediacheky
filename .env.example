# ===========================================
# MediaCheky Configuration
# ===========================================

# --- Core Configuration ---
MEDIACHEKY_SERVER_PORT=80
MEDIACHEKY_SERVER_PORT_SSL=443
MEDIACHEKY_MEDIA_PATH=./volumes/library

# --- Debug & Development ---
# MEDIACHEKY_APP_ENVIRONMENT=development
# MEDIACHEKY_APP_LOG_LEVEL=debug
# MEDIACHEKY_APP_DRY_RUN=false

# --- Database Configuration ---
# MEDIACHEKY_DATABASE_TYPE=sqlite
# MEDIACHEKY_DATABASE_PATH=/app/data/mediacheky.db

# --- Data Paths ---
# MEDIACHEKY_APP_DATA=./volumes/mediacheky-data

# --- Host Paths (for Docker socket operations) ---
# PWD is automatically set by shell
# MEDIACHEKY_HOST_PATH=${PWD}