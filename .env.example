# MediaCheky Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application environment (development, production)
MEDIACHEKY_APP_ENVIRONMENT=development

# Log level (debug, info, warn, error)
MEDIACHEKY_APP_LOG_LEVEL=debug

# Dry run mode - when true, no actual deletions will occur
MEDIACHEKY_APP_DRY_RUN=true

# Server port
MEDIACHEKY_SERVER_PORT=7369

# Database configuration
MEDIACHEKY_DATABASE_TYPE=sqlite
MEDIACHEKY_DATABASE_PATH=/app/data/mediacheky.db

# =============================================================================
# SERVICE CONFIGURATION (Managed through MediaCheky UI)
# =============================================================================
# The following services will be configured and managed through the MediaCheky
# web interface. These environment variables are provided as examples and may
# not be needed once the UI management is implemented.
# =============================================================================

# =============================================================================
# RADARR CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Radarr integration
# MEDIACHEKY_CLIENTS_RADARR_ENABLED=true

# Radarr service URL (use container name for Docker, or IP:port for external)
# MEDIACHEKY_CLIENTS_RADARR_URL=http://radarr:7878

# Radarr API Key (Settings → General → API Key)
# RADARR_API_KEY=your_radarr_api_key_here

# =============================================================================
# SONARR CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Sonarr integration
# MEDIACHEKY_CLIENTS_SONARR_ENABLED=true

# Sonarr service URL
# MEDIACHEKY_CLIENTS_SONARR_URL=http://sonarr:8989

# Sonarr API Key (Settings → General → API Key)
# SONARR_API_KEY=your_sonarr_api_key_here

# =============================================================================
# JELLYFIN CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Jellyfin integration
# MEDIACHEKY_CLIENTS_JELLYFIN_ENABLED=true

# Jellyfin service URL
# MEDIACHEKY_CLIENTS_JELLYFIN_URL=http://jellyfin:8096

# Jellyfin API Key (Dashboard → API Keys → Create New Key)
# JELLYFIN_API_KEY=your_jellyfin_api_key_here

# =============================================================================
# JELLYSEERR CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Jellyseerr integration
# MEDIACHEKY_CLIENTS_JELLYSEERR_ENABLED=true

# Jellyseerr service URL
# MEDIACHEKY_CLIENTS_JELLYSEERR_URL=http://jellyseerr:5055

# Jellyseerr API Key (Settings → General → API Key)
# JELLYSEERR_API_KEY=your_jellyseerr_api_key_here

# =============================================================================
# JELLYSTAT CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Jellystat integration (Jellyfin statistics and playback tracking)
# MEDIACHEKY_CLIENTS_JELLYSTAT_ENABLED=true

# Jellystat service URL
# MEDIACHEKY_CLIENTS_JELLYSTAT_URL=http://jellystat:3000

# Jellystat API Key (Settings → API Keys)
# JELLYSTAT_API_KEY=your_jellystat_api_key_here

# =============================================================================
# QBITTORRENT CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable qBittorrent integration
# MEDIACHEKY_CLIENTS_QBITTORRENT_ENABLED=true

# qBittorrent Web UI URL
# MEDIACHEKY_CLIENTS_QBITTORRENT_URL=http://qbittorrent:8080

# qBittorrent Web UI credentials
# Default: admin / adminadmin (change in qBittorrent Tools → Options → Web UI)
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=adminadmin

# =============================================================================
# BAZARR CLIENT (Example - Configure via UI)
# =============================================================================
# Enable/disable Bazarr integration (subtitle management)
# MEDIACHEKY_CLIENTS_BAZARR_ENABLED=true

# Bazarr service URL
# MEDIACHEKY_CLIENTS_BAZARR_URL=http://bazarr:6767

# Bazarr API Key (Settings → General → Security → API Key)
# BAZARR_API_KEY=your_bazarr_api_key_here
